{
  "name": "fae-console-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "工程小管家桌面客户端",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:mac": "electron-builder --mac dir --publish never"
  },
  "build": {
    "appId": "cn.patrick.fae-console.desktop",
    "productName": "工程小管家",
    "files": [
      "main.cjs",
      "classic.css",
      "package.json"
    ],
    "toolsets": {
      "nsis": "1.2.1"
    },
    "win": {
      "target": "portable",
      "icon": "assets/windows-icon.ico",
      "signExecutable": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}",
      "requestExecutionLevel": "user",
      "useZip": true
    }
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.1"
  }
}
